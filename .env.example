# Copy to .env and fill in. Never commit .env.
# Real values are shared in the team chat.

# Valio Aimo mock backend
AIMO_API_KEY=
AIMO_API_BASE_URL=https://junction26.valioaimo.fi

# Optional: enables the Claude parser (otherwise the rule-based parser is used)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# PARSER=auto            # auto | rules
# OFFER_TTL_MINUTES=30   # how long offer prices stay fixed

# Sign-in password for the buyer portal.
# Leave it empty for local development (signing in then needs no password).
# BUYER_PASSWORD=
# Public demo: show that password on the sign-in page so anyone can try the portal.
# SHOW_BUYER_PASSWORD=1
